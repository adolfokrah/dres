import type { GlobalConfig } from 'payload'

import { link } from '@/fields/link'
import { revalidateHeader } from './hooks/revalidateHeader'

export const Header: GlobalConfig = {
  slug: 'header',
  access: {
    read: () => true,
  },
  fields: [
    {
      name: 'navItems',
      type: 'array',
      label: 'Navigation Items',
      admin: {
        description: 'Main navigation menu items that appear in the header',
        initCollapsed: true,
        components: {
          RowLabel: '@/Header/RowLabel#RowLabel',
        },
      },
      fields: [
        {
          name: 'type',
          type: 'select',
          required: true,
          defaultValue: 'link',
          options: [
            { label: 'Simple Link', value: 'link' },
            { label: 'Department Mega Menu', value: 'department' },
            { label: 'Collection Mega Menu', value: 'collection' },
            { label: 'Custom Mega Menu', value: 'custom' },
          ],
        },
        {
          name: 'label',
          type: 'text',
          required: true,
          admin: {
            description: 'The text displayed in the navigation',
          },
        },
        {
          name: 'highlighted',
          type: 'checkbox',
          label: 'Highlight (Red)',
          defaultValue: false,
          admin: {
            description: 'Display this nav item in red (e.g., for Sale)',
          },
        },
        // Simple Link Fields
        link({
          appearances: false,
          overrides: {
            admin: {
              condition: (data, siblingData) => siblingData?.type === 'link',
            },
          },
        }),
        // Department Mega Menu Fields
        {
          name: 'department',
          type: 'relationship',
          relationTo: 'departments',
          admin: {
            description: 'Select a department to show its categories and collections',
            condition: (data, siblingData) => siblingData?.type === 'department',
          },
        },
        // Collection Mega Menu Fields
        {
          name: 'collections',
          type: 'relationship',
          relationTo: 'collections',
          hasMany: true,
          admin: {
            description: 'Select collections to display in the mega menu',
            condition: (data, siblingData) => siblingData?.type === 'collection',
          },
        },
        // Custom Mega Menu Fields
        {
          name: 'megaMenuSections',
          type: 'array',
          label: 'Mega Menu Sections',
          admin: {
            description: 'Create custom sections for the mega menu',
            condition: (data, siblingData) => siblingData?.type === 'custom',
            initCollapsed: true,
          },
          fields: [
            {
              name: 'title',
              type: 'text',
              required: true,
              admin: {
                description: 'Section heading (e.g., "CLOTHES", "SHOES")',
              },
            },
            {
              name: 'links',
              type: 'array',
              fields: [
                {
                  name: 'label',
                  type: 'text',
                  required: true,
                },
                link({
                  appearances: false,
                  overrides: {
                    name: 'linkDetails',
                  },
                }),
              ],
            },
          ],
        },
      ],
    },
  ],
  hooks: {
    afterChange: [revalidateHeader],
  },
}
